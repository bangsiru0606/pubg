  "jeong_haneul": {
   "start": "h1",
   "nodes": {
    "h1": {
     "speaker": "han_jisu",
     "text": "박은지 씨의 오빠가 찾고 있습니다.",
     "source": "spec",
     "portrait": "player_neutral",
     "next": "h2",
