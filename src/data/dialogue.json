      }
     ],
     "voice": "inner"
    },
    "b1": {
     "speaker": "han_jisu",
     "text": "P-271은 박은지였습니다. 장부와 이송표 모두 두 분 이름으로 연결됩니다.",
     "source": "spec",
     "portrait": "player_neutral",
     "next": "b2",
     "onEnter": {
      "preserve": "confront"
