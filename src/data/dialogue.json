     "next": "y3"
    },
    "y3": {
     "speaker": "han_yujin",
     "text": "얼굴은 천으로 가렸지만 노란 실팔찌를 봤어요. 은지 씨가 직접 만든 거였어요.",
     "source": "spec",
     "statement": {
      "id": "han_s_bracelet"
     },
     "onEnter": {
      "setFlags": [
       "han_done"
      ]
     }
    }
   },
