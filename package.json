{
  "name": "confession-ward",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "validate": "tsx tools/validate-data.ts",
    "assets": "tsx tools/normalize-assets.ts",
    "readme:credits": "tsx tools/readme-credits.ts",
    "sfx": "tsx tools/sfx/generate-sfx.ts",
    "sfx:report": "tsx tools/sfx/analyze-sfx.ts",
    "release:shots": "tsx tools/release-shots.ts",
    "build:release": "tsx tools/build-release.ts",
    "test:release": "tsx tools/test-release.ts",
    "screenshot": "tsx tools/screenshot.ts",
    "test:e2e": "tsx tools/test-e2e.ts",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "play": "tsx tools/play.ts",
    "test:dev": "tsx tools/test-dev.ts",
    "import:generated": "tsx tools/import-generated.ts",
    "ui-shots": "tsx tools/ui-shots.ts"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.6",
    "adm-zip": "^0.6.1",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
